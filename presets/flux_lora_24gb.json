{
  "job": "extension",
  "config": {
    "name": "preset",
    "process": [
      {
        "type": "diffusion_trainer",
        "training_folder": "output",
        "device": "cuda",
        "trigger_word": null,
        "network": {
          "type": "lora",
          "linear": 16,
          "linear_alpha": 16
        },
        "save": {
          "dtype": "bf16",
          "save_every": 250,
          "max_step_saves_to_keep": 4,
          "save_format": "safetensors",
          "push_to_hub": false
        },
        "datasets": [
          {
            "folder_path": "/path/to/images/folder",
            "caption_ext": "txt",
            "caption_dropout_rate": 0.05,
            "resolution": [
              512,
              768,
              1024
            ],
            "num_repeats": 1,
            "cache_latents_to_disk": true,
            "cache_latents": true
          }
        ],
        "train": {
          "batch_size": 1,
          "steps": 2500,
          "gradient_accumulation": 1,
          "train_unet": true,
          "train_text_encoder": false,
          "gradient_checkpointing": true,
          "noise_scheduler": "flowmatch",
          "optimizer": "adamw8bit",
          "timestep_type": "sigmoid",
          "content_or_style": "balanced",
          "lr": 0.0001,
          "dtype": "bf16",
          "ema_config": {
            "use_ema": true,
            "ema_decay": 0.99
          },
          "loss_sync_every": 4,
          "ui_db_poll_seconds": 2
        },
        "model": {
          "name_or_path": "black-forest-labs/FLUX.1-dev",
          "arch": "flux",
          "quantize": true,
          "qtype": "qfloat8",
          "quantize_te": true,
          "qtype_te": "qfloat8"
        },
        "sample": {
          "sampler": "flowmatch",
          "sample_every": 250,
          "width": 1024,
          "height": 1024,
          "guidance_scale": 4,
          "sample_steps": 25
        }
      }
    ]
  },
  "meta": {
    "name": "[name]",
    "version": "1.2",
    "description": "FLUX.1-dev LoRA sized for ~24GB VRAM (fp8 quantized model + text encoder), mirroring config/examples/train_lora_flux_24gb.yaml. v1.1: restored ema_config 0.99 from the canonical yaml this preset mirrors (Ostris: 'recommended to leave on'). Speed (2026-08-29): latents are served from RAM after the first pass (cache_latents + cache_latents_to_disk — disk-only caching re-read every latent every step), loss_sync_every 4, ui_db_poll_seconds 2. Training math unchanged."
  }
}
